<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <!-- This file shows all options for ResourceTypeDef, and explains what they do and their default values -->
  <FactionColonies.ResourceTypeDef>
	<defName>RTD_Example</defName>
	<label>resource label</label>
	<description>A brief description of the resource category.</description>
	<iconPath>path/to/your/resource/icon</iconPath>
	<uiPriority>determines the order this resource will appear in any lists. Lower value = higher in the list. Default: 10000</uiPriority>
	<!-- The thing allowlist allows you to specify individual things that can be selected for tithing in this category.-->
	<!-- Things that are specified in the allow list will always be available for this resource, even if they don't belong to any allowed categories, or DO belong to a blocked category.-->
	<thingAllowList>
		<li>
			<thingDef>Def of the Thing that you want to allow</thingDef>
			<minTechLevel>Minimum tech level for this thing to be available. Defaults to Undefined.</minTechLevel>
			<maxTechLevel>Maximum tech level for this thing to be available. Defaults to Undefined.</maxTechLevel>
			<researchProjectDefs>
				<li>A list of research projects that must be completed before this thing becomes available.</li>
			</researchProjectDefs>
			<restrictByRecipe>true if the thing's availability should be restricted by the requirements of its recipe. false otherwise. Default: true</restrictByRecipe>
			<restrictByThingTechLevel>true if the thing's availability should be restricted by its tech level. false otherwise. Default: true</restrictByThingTechLevel>
			<needsAllResearchRequirements>true if the player needs to meet all specified requirements in order for this thing to be available.
			                              false if they only need to meet one. Default: false
										  Note: if restrictByRecipe or restrictByThingTechLevel are set to false, then they will not be considered.</needsAllResearchRequirements>
		</li>
	</thingAllowList>
	<!-- The thing blocklist allows you to specify individual things that will never be available for this category.-->
	<!-- Useful if you've specified a ThingCategoryDef or StuffCategoryDef, but want to block a subset of the category.-->
	<!-- Things on the blocklist will always be blocked, unconditionally.-->
	<thingBlockList>
		<li>thingDef to block</li>
	</thingBlockList>
	<!-- The thingCategory allowlist functions similarly to the thingAllowList, but lets you specify thing categories instead.-->
	<!-- thingAllowList and thingBlockList will always take precedence over the thingCategoryAllowList.-->
	<thingCategoryAllowList>
		<li>
			<thingCategoryDef>Def of the ThingCategory that you want to allow</thingCategoryDef>
			<minTechLevel>Minimum tech level for this thingCategory to be available. Defaults to Undefined.</minTechLevel>
			<maxTechLevel>Maximum tech level for this thingCategory to be available. Defaults to Undefined.</maxTechLevel>
			<researchProjectDefs>
				<li>A list of research projects that must be completed before this thingCategory becomes available.</li>
			</researchProjectDefs>
			<restrictByRecipe>true if the availability of things in this thingCategory should be restricted by their recipe requirements. false otherwise. Default: true</restrictByRecipe>
			<restrictByThingTechLevel>true if the availability of things in this thingCategory should be restricted by their tech level. false otherwise. Default: true</restrictByThingTechLevel>
			<needsAllResearchRequirements>true if the player needs to meet all specified requirements in order for things in this thingCategory to be available.
			                              false if they only need to meet one. Default: false
										  Note: if restrictByRecipe or restrictByThingTechLevel are set to false, then they will not be considered.</needsAllResearchRequirements>
		</li>
	</thingCategoryAllowList>
	<!-- The thingCategory blockList functions similarly to the thing blocklist, but lets you block categories instead.-->
	<!-- The thingCategory blocklist always takes precedence over the thingCategory allowlist.-->
	<!-- The thingCategory blocklist always loses precedence to the thingAllowList and thingBlockList.-->
	<thingCategoryBlockList>
		<li>thingCategoryDef to block</li>
	</thingCategoryBlockList>
	<!-- The stuffCategory allowlist is similar to the thingCategory allowlist in that you can specify StuffCategoryDefs to allow.-->
	<!-- No fancy specifications for this list. All you need to specify are the category defs.-->
	<!-- thingAllowList and thingBlockList will always take precedence over the stuffCategoryAllowList.-->
	<stuffCategoryAllowList>
		<li>stuffCategoryDef to allow</li>
	</stuffCategoryAllowList>
	<!-- The stuffCategory blockList functions similarly to the thing blocklist, but lets you block categories instead.-->
	<!-- The stuffCategory blocklist always takes precedence over the stuffCategory allowlist.-->
	<!-- The stuffCategory blocklist always loses precedence to the thingAllowList and thingBlockList.-->
	<stuffCategoryBlockList>
		<li>stuffCategoryDef to block</li>
	</stuffCategoryBlockList>
	<!-- For tech level specifications, "Undefined" is treated as though the techlevel requirement doesn't have to be met.-->
	<!-- In other words, *any* tech level will satisfy a requirement that is set to Undefined.-->
	<minTechLevel>minimum tech level for this resource to be available. Default: Undefined</minTechLevel>
	<maxTechLevel>maximum tech level for this resource to be available. Default: Undefined</maxTechLevel>
	<!-- researchProjectDefs lets you specify a list of research projects that must be completed before this resource becomes available. -->
	<researchProjectDefs>
		<li>a researchProjectDef to require</li>
	</researchProjectDefs>
	<needsAllResearchRequirements>true if both the techlevel requirements and researchProjectDef requirements need to be met. false otherwise. Default: false</needsAllResearchRequirements>
	<!-- Pool reources are unique resources that function as point pools instead of giving you items. The Research and Power resources are both pool resources, for example.-->
	<!-- If a resource is a pool resource, then it cannot specify any allowlists for things, thingCategories, or stuffCategories.-->
	<!-- If a resource is a pool resource, then it MUST specify a ResourcePoolExtension in the modExtensions section. You will need to extend the abstract ResourcePoolExtension class,-->
	<!--     and override any necessary functions for your resource to work. Refer to ResourcePoolExt_Power (for power) and ResourcePoolExt_Research (for research) as examples.-->
	<isPoolResource>true if the resource represents a pool of points instead of tangible items. Default: false</isPoolResource>
	<!-- titheMinCount, titheMaxCountBase, and titheMaxCountScaler all control how much of a resource you get when tithing. They do not apply to pool resources.-->
	<!-- The range of items is set as (titheMinCount, titheMaxCountBase + (titheMaxCountScaler * multiplier)) where "multiplier" is determine by the code.-->
	<titheMinCount>1</titheMinCount>
	<titheMaxCountBase>5</titheMaxCountBase>
	<titheMaxCountScaler>1</titheMaxCountScaler>
	<!-- defenseWeight controls how much this resource's production contributes to settlement defense. 0 means no contribution. Default: 0 -->
	<defenseWeight>1.0</defenseWeight>
	<!-- Specify any modExtensions necessary for your resource. There are four types of extensions that you can extend to add functionality:
	     1) ResourceProductionExtension: allows you to specify additional additives or multipliers for this resource with your own conditionals
		 2) ResourceFilterExtension: allows for more fine-grained control over what types of things are allowed for this resource, rather than simple
		                             allowlists/blocklists. Is used by the Animals resource to specify animals for tithing.
		 3) ResourcePoolExtension: must be specified for pool resources. Specifies how the pools are created and managed. You'll need to create your own
		                           custom ResourcePoolExtension by extending the base ResourcePoolExtension class.
		 4) ResourceTaxExtension: provides pre/post hooks into the tithe generation process for non-pool resources. Extend this to modify
		                          generated tithes or resource state at tax time. Cannot be used on pool resources.-->
	<modExtensions>
		<!-- The Hillious ResourceProductionExtension allows you to specify any additive or multiplier bonuses for this resource based on tile hilliness.-->
		<!-- You only need to specify the values that you want to change. Any unspecified modifier or hilliness level will use the defaults of 0 for additive, and 1 for multiplier.-->
		<!-- If your resource isn't modified by hilliness at all, then you don't need to include this extension at all.-->
		<li Class="FactionColonies.ResourceProductionExtension_Hilliness">
			<li>
				<hilliness>Flat</hilliness>
				<additive>0</additive>
				<multiplier>1.1</multiplier>
			</li>
			<li>
				<hilliness>SmallHills</hilliness>
				<additive>0</additive>
				<multiplier>1</multiplier>
			</li>
			<li>
				<hilliness>LargeHills</hilliness>
				<additive>0</additive>
				<multiplier>1</multiplier>
			</li>
			<li>
				<hilliness>Mountainous</hilliness>
				<additive>0</additive>
				<multiplier>0.5</multiplier>
			</li>
		</li>
	</modExtensions>
  </FactionColonies.ResourceTypeDef>
  

</Defs>
