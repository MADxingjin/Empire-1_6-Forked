<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>independencePetitions_0</defName>
		<label>Independence Petitions</label>
		<desc>Due to unrest in your faction, a growing number of your towns have the idea of independence growing. How will you address the dissent?</desc>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>independencePetitions_0_1</li>
			<li>independencePetitions_0_2</li>
			<li>independencePetitions_0_3</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
			<li>independencePetitions_1-1</li>
			<li>independencePetitions_1-2</li>
			<li>independencePetitions_1-3</li>
		</incompatibleEvents>
		<minimumUnrest>20</minimumUnrest>
		<maximumUnrest>100</maximumUnrest>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>independencePetitions_0_1</defName>
		<label>Let them petition. We are a just empire.</label>
		<parentEvent>independencePetitions_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>independencePetitions_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>independencePetitions_0_2</defName>
		<label>Address their grievances — distribute aid to the discontented.</label>
		<parentEvent>independencePetitions_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>500</silverCost>
		<successEvent>independencePetitions_1-2</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>independencePetitions_0_3</defName>
		<label>Suppress the movement with force.</label>
		<parentEvent>independencePetitions_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>independencePetitions_1-3</successEvent>
		<failEvent></failEvent>
		<requiredPolicies>
			<li>authoritarian</li>
		</requiredPolicies>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>independencePetitions_1-1</defName>
		<label>Independence Petitions</label>
		<desc>The petitions continue unopposed. The movement grows as more settlements consider independence. -5 loyalty a day, -5 prosperity a day, +1 unrest a day.</desc>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>loyaltyLostBase</stat><value>5</value></li>
			<li><stat>unrestGainedBase</stat><value>1</value></li>
			<li><stat>prosperityBaseRecovery</stat><value>-5</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>independencePetitions_1-2</defName>
		<label>Independence Petitions (Grievances Addressed)</label>
		<desc>Aid is distributed to the discontented settlements. The gesture helps, but the underlying tensions remain. -3 loyalty a day, -3 prosperity a day.</desc>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>loyaltyLostBase</stat><value>3</value></li>
			<li><stat>prosperityBaseRecovery</stat><value>-3</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>independencePetitions_1-3</defName>
		<label>Independence Petitions (Suppressed)</label>
		<desc>The independence movement is crushed by force. The dissidents are silenced, but the heavy-handed response breeds further resentment. -1 loyalty a day, +3 unrest a day.</desc>
		<timeTillTrigger>180000</timeTillTrigger>
		<statModifiers>
			<li><stat>loyaltyLostBase</stat><value>1</value></li>
			<li><stat>unrestGainedBase</stat><value>3</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
