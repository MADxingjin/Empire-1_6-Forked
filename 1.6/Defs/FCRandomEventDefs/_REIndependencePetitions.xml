<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>independencePetitions</defName>
		<label>Independence Petitions</label>
		<desc>Due to unrest in your faction, a growing number of your towns have the idea of independence growing. -5 loyalty a day. -5 prosperity a day. +1 unrest a day.</desc>

		<timeTillTrigger>300000</timeTillTrigger>

		<statModifiers>
			<li><stat>loyaltyLostBase</stat><value>5</value></li>
			<li><stat>unrestGainedBase</stat><value>1</value></li>
			<li><stat>prosperityBaseRecovery</stat><value>-5</value></li>
		</statModifiers>

		<options>
		</options>
		<activateAtStart>false</activateAtStart>

		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
		</incompatibleEvents>
		<minimumUnrest>20</minimumUnrest>
		<maximumUnrest>100</maximumUnrest>

		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>

	</FactionColonies.FCEventDef>

</Defs>
