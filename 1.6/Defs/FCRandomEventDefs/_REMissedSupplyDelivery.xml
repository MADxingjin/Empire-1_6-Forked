<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>missedSupplyDelivery_0</defName>
		<label>Missed Supply Delivery</label>
		<desc>The craftsmen in the affected region(s) are suffering from a lack of supplies. How should they adapt?</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>missedSupplyDelivery_0_1</li>
			<li>missedSupplyDelivery_0_2</li>
			<li>missedSupplyDelivery_0_3</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
			<li>missedSupplyDelivery_1-1</li>
			<li>missedSupplyDelivery_1-2</li>
			<li>missedSupplyDelivery_1-3</li>
			<li>unexpectedCraftsmanship_1-1</li>
			<li>unexpectedCraftsmanship_1-2</li>
			<li>unexpectedCraftsmanship_1-3</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>missedSupplyDelivery_0_1</defName>
		<label>We'll wait for the next delivery.</label>
		<parentEvent>missedSupplyDelivery_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>missedSupplyDelivery_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>missedSupplyDelivery_0_2</defName>
		<label>Source replacement supplies from local traders.</label>
		<parentEvent>missedSupplyDelivery_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>300</silverCost>
		<successEvent>missedSupplyDelivery_1-2</successEvent>
		<failEvent></failEvent>
		<requiredPolicies>
			<li>mercantile</li>
		</requiredPolicies>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>missedSupplyDelivery_0_3</defName>
		<label>Have the craftsmen improvise with local materials.</label>
		<parentEvent>missedSupplyDelivery_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>missedSupplyDelivery_1-3</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>missedSupplyDelivery_1-1</defName>
		<label>Missed Supply Delivery</label>
		<desc>The craftsmen wait for the next delivery. -0.5 weapons and -0.5 apparel base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Weapons_ProductionAdditive</stat><value>-0.5</value></li>
			<li><stat>RTD_Apparel_ProductionAdditive</stat><value>-0.5</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>missedSupplyDelivery_0</li>
			<li>unexpectedCraftsmanship_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>missedSupplyDelivery_1-2</defName>
		<label>Missed Supply Delivery (Local Sourcing)</label>
		<desc>Trade connections help source replacement supplies locally. -0.25 weapons and -0.25 apparel base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Weapons_ProductionAdditive</stat><value>-0.25</value></li>
			<li><stat>RTD_Apparel_ProductionAdditive</stat><value>-0.25</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>missedSupplyDelivery_0</li>
			<li>unexpectedCraftsmanship_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>missedSupplyDelivery_1-3</defName>
		<label>Missed Supply Delivery (Improvised)</label>
		<desc>The craftsmen improvise with local materials, focusing their limited supplies on apparel. -1 weapons base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Weapons_ProductionAdditive</stat><value>-1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>missedSupplyDelivery_0</li>
			<li>unexpectedCraftsmanship_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
