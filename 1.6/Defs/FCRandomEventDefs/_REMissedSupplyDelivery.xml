<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>missedSupplyDelivery</defName>
		<label>Missed Supply Delivery</label>
		<desc>The craftsmen in the affected region(s) are suffering from a lack of supplies. -0.5 weapons base production and -0.5 apparel base production.</desc>

		<timeTillTrigger>300000</timeTillTrigger>
		<perpetual>false</perpetual>

		<statModifiers>
			<li><stat>RTD_Weapons_ProductionAdditive</stat><value>-0.5</value></li>
			<li><stat>RTD_Apparel_ProductionAdditive</stat><value>-0.5</value></li>
		</statModifiers>

		<options>
		</options>
		<activateAtStart>false</activateAtStart>

		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
		<li>unexpectedCraftsmanship</li>
		</incompatibleEvents>

		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>

	</FactionColonies.FCEventDef>

</Defs>
