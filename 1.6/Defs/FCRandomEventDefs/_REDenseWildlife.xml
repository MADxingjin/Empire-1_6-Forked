<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>denseWildlife_0</defName>
		<label>Dense Wildlife</label>
		<desc>There is a great amount of animals roaming the region. How should your settlements take advantage?</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>denseWildlife_0_1</li>
			<li>denseWildlife_0_2</li>
			<li>denseWildlife_0_3</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
			<li>denseWildlife_1-1</li>
			<li>denseWildlife_1-2</li>
			<li>denseWildlife_1-3</li>
			<li>sparseWildlife_0</li>
			<li>sparseWildlife_1-1</li>
			<li>sparseWildlife_1-2</li>
			<li>sparseWildlife_1-3</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
		<restrictedBiomes>
			<li>Desert</li>
			<li>ExtremeDesert</li>
			<li>IceSheet</li>
			<li>SeaIce</li>
		</restrictedBiomes>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>denseWildlife_0_1</defName>
		<label>Let the herds flourish and boost our animal production.</label>
		<parentEvent>denseWildlife_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>denseWildlife_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>denseWildlife_0_2</defName>
		<label>Organize a grand hunt and bring back the spoils.</label>
		<parentEvent>denseWildlife_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>denseWildlife_1-2</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>denseWildlife_0_3</defName>
		<label>Capture and domesticate what we can for long-term gains.</label>
		<parentEvent>denseWildlife_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>denseWildlife_1-3</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>denseWildlife_1-1</defName>
		<label>Dense Wildlife</label>
		<desc>The herds flourish and boost animal production. +1 animals base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Animals_ProductionAdditive</stat><value>1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>denseWildlife_0</li>
			<li>sparseWildlife_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>denseWildlife_1-2</defName>
		<label>Dense Wildlife (Grand Hunt)</label>
		<desc>A grand hunt is organized, bringing back valuable animal products.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>1500</timeTillTrigger>
		<randomThingRewardDef>RERD_Animals</randomThingRewardDef>
		<randomThingValue>500</randomThingValue>
		<incompatibleEvents>
			<li>denseWildlife_0</li>
			<li>sparseWildlife_0</li>
		</incompatibleEvents>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>denseWildlife_1-3</defName>
		<label>Dense Wildlife (Domestication)</label>
		<desc>Some of the animals are captured and domesticated for long-term gains. +0.5 animals and +0.5 food base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>360000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Animals_ProductionAdditive</stat><value>0.5</value></li>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>0.5</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>denseWildlife_0</li>
			<li>sparseWildlife_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
