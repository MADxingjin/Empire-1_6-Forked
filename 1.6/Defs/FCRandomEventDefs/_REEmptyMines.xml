<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>emptyMines_0</defName>
		<label>Empty Mines</label>
		<desc>The affected region(s) have been stricken with barren mines. What should be done?</desc>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>emptyMines_0_1</li>
			<li>emptyMines_0_2</li>
			<li>emptyMines_0_3</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
			<li>emptyMines_1-1</li>
			<li>emptyMines_1-2f</li>
			<li>emptyMines_1-3</li>
			<li>struckRichOreVein_1-1</li>
			<li>struckRichOreVein_1-2</li>
			<li>struckRichOreVein_1-3</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>emptyMines_0_1</defName>
		<label>The miners will have to wait for new veins to appear.</label>
		<parentEvent>emptyMines_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>emptyMines_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>emptyMines_0_2</defName>
		<label>Hire prospectors to search for untapped deposits.</label>
		<parentEvent>emptyMines_0</parentEvent>
		<baseChanceOfSuccess>60</baseChanceOfSuccess>
		<silverCost>400</silverCost>
		<successEvent>Null</successEvent>
		<failEvent>emptyMines_1-2f</failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>emptyMines_0_3</defName>
		<label>Redirect the idle miners to settlement construction.</label>
		<parentEvent>emptyMines_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>emptyMines_1-3</successEvent>
		<failEvent></failEvent>
		<requiredPolicies>
			<li>industrious</li>
		</requiredPolicies>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>emptyMines_1-1</defName>
		<label>Empty Mines</label>
		<desc>The miners wait for new veins to surface. -1 mining base production.</desc>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Mining_ProductionAdditive</stat><value>-1</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>emptyMines_1-2f</defName>
		<label>Empty Mines (Prospectors Failed)</label>
		<desc>The prospectors found nothing. The mines remain empty. -1 mining base production.</desc>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Mining_ProductionAdditive</stat><value>-1</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>emptyMines_1-3</defName>
		<label>Empty Mines (Construction Redirect)</label>
		<desc>Idle miners are put to work on settlement construction projects. -1 mining base production, but construction speeds up.</desc>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Mining_ProductionAdditive</stat><value>-1</value></li>
			<li><stat>buildTimeMultiplier</stat><value>0.25</value></li>
		</statModifiers>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
