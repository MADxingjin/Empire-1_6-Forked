<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>foodSurplus_0</defName>
		<label>Food Surplus</label>
		<desc>Lucky harvests have led to a surplus of food in some settlements. What should be done with the excess?</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>foodSurplus_0_1</li>
			<li>foodSurplus_0_2</li>
			<li>foodSurplus_0_3</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
			<li>foodSurplus_1-1</li>
			<li>foodSurplus_1-2</li>
			<li>foodSurplus_1-3</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>foodSurplus_0_1</defName>
		<label>Store the surplus for continued production.</label>
		<parentEvent>foodSurplus_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodSurplus_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>foodSurplus_0_2</defName>
		<label>Sell the excess harvest to traders.</label>
		<parentEvent>foodSurplus_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodSurplus_1-2</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>foodSurplus_0_3</defName>
		<label>Host a grand feast to celebrate the bounty.</label>
		<parentEvent>foodSurplus_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodSurplus_1-3</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>foodSurplus_1-1</defName>
		<label>Food Surplus</label>
		<desc>The surplus is stored for continued production. +1 food base production.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<statModifiers>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>foodSurplus_1-2</defName>
		<label>Food Surplus (Sold)</label>
		<desc>The excess harvest is sold to passing traders.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>1500</timeTillTrigger>
		<randomThingRewardDef>RERD_Food</randomThingRewardDef>
		<randomThingValue>500</randomThingValue>
		<incompatibleEvents>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>foodSurplus_1-3</defName>
		<label>Food Surplus (Feast)</label>
		<desc>A grand feast is held to celebrate the bounty! Citizens are happy and loyal. +2 happiness, +1 loyalty.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>180000</timeTillTrigger>
		<statModifiers>
			<li><stat>happinessGainedBase</stat><value>2</value></li>
			<li><stat>loyaltyGainedBase</stat><value>1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
