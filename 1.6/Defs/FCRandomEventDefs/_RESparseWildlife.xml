<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>sparseWildlife</defName>
		<label>Sparse Wildlife</label>
		<desc>The wildlife in the affected region(s) have all but disappeared. -1 animals base production.</desc>

		<timeTillTrigger>300000</timeTillTrigger>
		<perpetual>false</perpetual>

		<resourceBonuses>
			<li>
				<resourceDef>RTD_Animals</resourceDef>
				<additive>-1</additive>
			</li>
		</resourceBonuses>

		<options>
		</options>
		<activateAtStart>false</activateAtStart>

		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
		<li>denseWildlife</li>
		</incompatibleEvents>

		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>

	</FactionColonies.FCEventDef>

</Defs>
