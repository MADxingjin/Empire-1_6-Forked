<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>foodShortage_0</defName>
		<label>Widespread Food Shortage</label>
		<desc>There's a widespread food shortage in the affected regions. Your settlements need guidance on how to handle this crisis.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>0</timeTillTrigger>
		<options>
			<li>foodShortage_0_1</li>
			<li>foodShortage_0_2</li>
			<li>foodShortage_0_3</li>
			<li>foodShortage_0_4</li>
		</options>
		<activateAtStart>true</activateAtStart>
		<isRandomEvent>true</isRandomEvent>
		<isNegative>true</isNegative>
		<weight>25</weight>
		<incompatibleEvents>
			<li>foodShortage_1-1</li>
			<li>foodShortage_1-2</li>
			<li>foodShortage_1-3</li>
			<li>foodShortage_1-4</li>
			<li>foodSurplus_0</li>
			<li>foodSurplus_1-1</li>
			<li>foodSurplus_1-2</li>
			<li>foodSurplus_1-3</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
		<requiredResource>RTD_Food</requiredResource>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCOptionDef>
		<defName>foodShortage_0_1</defName>
		<label>There's little we can do. We'll endure the shortage.</label>
		<parentEvent>foodShortage_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodShortage_1-1</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>foodShortage_0_2</defName>
		<label>Purchase emergency food imports to soften the blow.</label>
		<parentEvent>foodShortage_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>300</silverCost>
		<successEvent>foodShortage_1-2</successEvent>
		<failEvent></failEvent>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>foodShortage_0_3</defName>
		<label>Enforce strict rationing — shared sacrifice builds loyalty.</label>
		<parentEvent>foodShortage_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodShortage_1-3</successEvent>
		<failEvent></failEvent>
		<requiredPolicies>
			<li>egalitarian</li>
		</requiredPolicies>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCOptionDef>
		<defName>foodShortage_0_4</defName>
		<label>Let the slaves starve. The workers will eat.</label>
		<parentEvent>foodShortage_0</parentEvent>
		<baseChanceOfSuccess>100</baseChanceOfSuccess>
		<silverCost>0</silverCost>
		<successEvent>foodShortage_1-4</successEvent>
		<failEvent></failEvent>
		<requiredPolicies>
			<li>slaver</li>
		</requiredPolicies>
	</FactionColonies.FCOptionDef>

	<FactionColonies.FCEventDef>
		<defName>foodShortage_1-1</defName>
		<label>Food Shortage</label>
		<desc>Your settlements endure the food shortage.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<timeTillTriggerMax>420000</timeTillTriggerMax>
		<statModifiers>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>-1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodShortage_0</li>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>foodShortage_1-2</defName>
		<label>Food Shortage (Imports)</label>
		<desc>Emergency imports have arrived, lessening the impact of the food shortage.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<timeTillTriggerMax>420000</timeTillTriggerMax>
		<statModifiers>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>-0.5</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodShortage_0</li>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>foodShortage_1-3</defName>
		<label>Food Shortage (Rationing)</label>
		<desc>Strict rationing is in effect. Citizens admire the shared sacrifice.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<timeTillTriggerMax>420000</timeTillTriggerMax>
		<statModifiers>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>-1</value></li>
			<li><stat>loyaltyGainedBase</stat><value>1</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodShortage_0</li>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

	<FactionColonies.FCEventDef>
		<defName>foodShortage_1-4</defName>
		<label>Food Shortage (Slaves Starved)</label>
		<desc>The slaves bear the brunt of the shortage. Food production continues unaffected, but the workforce is diminished.</desc>
		<category>EC_Economy</category>
		<timeTillTrigger>300000</timeTillTrigger>
		<timeTillTriggerMax>420000</timeTillTriggerMax>
		<statModifiers>
			<li><stat>workerBaseMax</stat><value>-2</value></li>
		</statModifiers>
		<incompatibleEvents>
			<li>foodShortage_0</li>
			<li>foodSurplus_0</li>
		</incompatibleEvents>
		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>
	</FactionColonies.FCEventDef>

</Defs>
