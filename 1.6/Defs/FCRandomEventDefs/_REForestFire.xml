<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>forestFire</defName>
		<label>Massive Forest Fire</label>
		<desc>The affected region(s) have forest fires blazing out of control. -1 logging base production.</desc>

		<timeTillTrigger>300000</timeTillTrigger>
		<perpetual>false</perpetual>

		<resourceBonuses>
			<li>
				<resourceDef>RTD_Logging</resourceDef>
				<additive>-1</additive>
			</li>
		</resourceBonuses>

		<options>
		</options>
		<activateAtStart>false</activateAtStart>

		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
		<li>expandedForestry</li>
		</incompatibleEvents>

		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>

	</FactionColonies.FCEventDef>

</Defs>
