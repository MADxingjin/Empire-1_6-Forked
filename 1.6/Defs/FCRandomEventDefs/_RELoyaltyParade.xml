<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCEventDef>
		<defName>loyaltyParade</defName>
		<label>Loyalty Parade</label>
		<desc>Some of the settlements in your faction are having a parade in your honor! +1 loyalty a day. -2 unrest a day.</desc>

		<timeTillTrigger>300000</timeTillTrigger>

		<statModifiers>
			<li><stat>loyaltyGainedBase</stat><value>1</value></li>
			<li><stat>unrestLostBase</stat><value>2</value></li>
		</statModifiers>

		<options>
		</options>
		<activateAtStart>false</activateAtStart>

		<isRandomEvent>true</isRandomEvent>
		<weight>25</weight>
		<incompatibleEvents>
		</incompatibleEvents>
		<minimumLoyalty>80</minimumLoyalty>
		<maximumLoyalty>100</maximumLoyalty>

		<rangeSettlementsAffected>1~3</rangeSettlementsAffected>
		<settlementsCarryOver>true</settlementsCarryOver>

	</FactionColonies.FCEventDef>

</Defs>
