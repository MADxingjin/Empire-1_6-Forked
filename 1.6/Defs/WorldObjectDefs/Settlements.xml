<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <FactionColonies.WorldSettlementDef Name="WorldSettlementDefBase" ParentName="StaticWorldObjectBase" Abstract="True">
    <label>empire settlement</label>
    <description>A base of the Empire player faction</description>
    <worldObjectClass>FactionColonies.WorldSettlementFC</worldObjectClass>
    <mapGenerator>Empire_Base</mapGenerator>
    <fullyExpandedInSpace>true</fullyExpandedInSpace>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>10</expandingIconPriority>
    <canBePlayerHome>false</canBePlayerHome>
  </FactionColonies.WorldSettlementDef>
  
  <FactionColonies.WorldSettlementDef Name="WorldSettlementDef_Surface" ParentName="WorldSettlementDefBase">
    <defName>WorldSettlementDef_Surface</defName>
	<defaultResources>true</defaultResources>
	<planetLayers>
		<li>Surface</li>
	</planetLayers>
    <comps>
      <li Class="WorldObjectCompProperties_TradeRequest" />
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementOpenWindow" />
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementMilitary" />
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementBuildings" />
    </comps>
	<modExtensions>
		<li Class="FactionColonies.SettlementTypeExtension" />
	</modExtensions>
  </FactionColonies.WorldSettlementDef>
  
  <!-- Orbital Settlements -->
  <FactionColonies.WorldSettlementDef Name="WorldSettlementDef_Orbital" ParentName="WorldSettlementDefBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>WorldSettlementDef_Orbital</defName>
    <label>basic orbital colony</label>
    <description>Standard orbital construction capabilities</description>
	<titleKey>Orbital</titleKey>
	<descriptionKey>Orbital</descriptionKey>
	<accentColor>(0.50, 0.50, 0.50)</accentColor>
	<defaultResources>true</defaultResources>
	<supportsManualBattle>false</supportsManualBattle>
	<resources>
		<li>
			<resourceDef>RTD_Chemfuel</resourceDef>
		</li>
		<li>
			<resourceDef>RTD_Gravtech</resourceDef>
		</li>
	</resources>
	<biomeResourceOverride>OrbitalSpace</biomeResourceOverride>
	<researchProjects>
		<li>OrbitalConstruction</li>
	</researchProjects>
	<planetLayers>
		<li>Orbit</li>
	</planetLayers>
    <comps>
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementOpenWindow" />
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementMilitary" />
	  <li Class="FactionColonies.WorldObjectCompProperties_SettlementBuildings" />
    </comps>
	<modExtensions>
		<li Class="FactionColonies.SettlementTypeExtension_Orbital">
			<constructionDays>8</constructionDays>
		</li>
	</modExtensions>
  </FactionColonies.WorldSettlementDef>
  
  <FactionColonies.WorldSettlementDef ParentName="WorldSettlementDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>WorldSettlementDef_Orbital_Logistics</defName>
    <label>logistics orbital colony</label>
    <description>50% faster tax delivery and special buildings</description>
	<baseSettlementType>WorldSettlementDef_Orbital</baseSettlementType>
	<researchProjects>
		<li>OrbitalLogistics</li>
	</researchProjects>
  </FactionColonies.WorldSettlementDef>

  <FactionColonies.WorldSettlementDef ParentName="WorldSettlementDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>WorldSettlementDef_Orbital_Advanced</defName>
    <label>advanced orbital colony</label>
    <description>25% lower base construction cost, larger size</description>
	<baseSettlementType>WorldSettlementDef_Orbital</baseSettlementType>
	<researchProjects>
		<li>AdvancedOrbitalEngineering</li>
	</researchProjects>
  </FactionColonies.WorldSettlementDef>

  <FactionColonies.WorldSettlementDef ParentName="WorldSettlementDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>WorldSettlementDef_Orbital_Glitter</defName>
    <label>glitterworld orbital colony</label>
    <description>Specialized production buildings with bonuses</description>
	<baseSettlementType>WorldSettlementDef_Orbital</baseSettlementType>
	<researchProjects>
		<li>GlitterworldOrbitalSettlements</li>
	</researchProjects>
  </FactionColonies.WorldSettlementDef>

</Defs>
