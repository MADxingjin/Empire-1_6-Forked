<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.FCPolicyDef>
		<defName>minimizeTaxation</defName> <!--Name of Def -->
		<label>Minimize Taxation</label> <!--Lable of Def -->
		<desc>Collect less taxes from your settlements. This will make them happier and reduce unrest. 65% basetax, +.5 happiness a day, -1 unrest a day.</desc> <!-- Description of trait -->
		<cost>0</cost>
		<type>taxPolicy</type> <!-- only displays with specific type: taxPolicy, socialPolicy, militaryPolicy, factionTrait, settlementTrait -->
		<techLevel>Undefined</techLevel>
		<enactDuration>300000</enactDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>taxBasePercentage</stat><value>-35</value></li>
			<li><stat>happinessGainedBase</stat><value>0.5</value></li>
			<li><stat>unrestLostBase</stat><value>1</value></li>
		</statModifiers>
	</FactionColonies.FCPolicyDef>

	<FactionColonies.FCPolicyDef>
		<defName>heavyTaxation</defName> <!--Name of Def -->
		<label>Heavy Taxation</label> <!--Lable of Def -->
		<desc>Increase the amount of taxes on your settlements. 125% basetax, -.5 happiness a day, +1 unrest per day, -50% unrest lost, -50% happiness gained.</desc> <!-- Description of trait -->
		<cost>0</cost>
		<type>taxPolicy</type> <!-- only displays with specific type: taxPolicy, socialPolicy, militaryPolicy, factionTrait, settlementTrait -->
		<techLevel>Undefined</techLevel>
		<enactDuration>300000</enactDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>taxBasePercentage</stat><value>25</value></li>
			<li><stat>happinessLostBase</stat><value>0.5</value></li>
			<li><stat>unrestGainedBase</stat><value>1</value></li>
			<li><stat>happinessGainedMultiplier</stat><value>0.5</value></li>
			<li><stat>unrestLostMultiplier</stat><value>0.5</value></li>
		</statModifiers>
	</FactionColonies.FCPolicyDef>

</Defs>