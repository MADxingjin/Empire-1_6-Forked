<?xml version="1.0" encoding="utf-8" ?>
<!-- Per-resource Empire caravan traders. Each generates stock from empire-wide
     production of a single resource type. -->
<Defs>

  <TraderKindDef>
    <defName>Caravan_Empire_Food</defName>
    <label>empire food trader</label>
    <hideThingsNotWillingToTrade>false</hideThingsNotWillingToTrade>
    <tradeCurrency>Silver</tradeCurrency>
    <stockGenerators>
      <li Class="FactionColonies.EmpireCaravanStockGenerator">
        <resourceDef>RTD_Food</resourceDef>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

